NZB_API_URL=https://api.nzbplanet.net/api
NZB_API_KEY=
SAB_URL=http://127.0.0.1:8080/api
SAB_API_KEY=
# Set to false when SABnzbd serves HTTPS with a self-signed certificate
SAB_VERIFY_SSL=true
ROMCOM_DB=romcom.db
ROMCOM_SAB_CATEGORY=odin

# Where SABnzbd's completed downloads land (or its complete-folder root; the scan is recursive)
ROMCOM_DOWNLOAD_DIR=
ROMCOM_ACQUIRE_POLL=30
ROMCOM_ACQUIRE_MAX_WAIT_MIN=240
ROMCOM_ACQUIRE_BATCH_MAX=0

# Rolling pipeline: downloads kept in flight at once (0 = unlimited)
ROMCOM_ACQUIRE_PARALLEL=3
# Always-on watcher: sweeps, imports, rests, sweeps again
ROMCOM_ACQUIRE_WATCH=false
ROMCOM_ACQUIRE_INTERVAL=300
# Items one watcher sweep may attempt before it ends and re-sweeps (0 = unlimited)
ROMCOM_ACQUIRE_WATCH_BATCH=50
ROMCOM_ACQUIRE_SWEEP_PAUSE=15

# romsgames.net direct-download fallback, deliberately paced to stay under their rate limit
ROMCOM_WEBDL_BASE=https://www.romsgames.net
ROMCOM_WEBDL_DELAY=30
ROMCOM_WEBDL_JITTER=15
ROMCOM_WEBDL_TIMEOUT=60

# vimm.net direct-download source — an opt-in second fallback, off by default. Its detail
# pages sit behind an interactive Cloudflare challenge, so enabling it is not recommended.
ROMCOM_VIMM_ENABLED=false
ROMCOM_VIMM_BASE=https://vimm.net
ROMCOM_VIMM_DL_BASE=https://download.vimm.net
ROMCOM_VIMM_DELAY=20
ROMCOM_VIMM_JITTER=10
ROMCOM_VIMM_TIMEOUT=120

# Optional Ollama model used to disambiguate below-floor acquire candidates. Off by default,
# and fail-open: any error just means "no confident match" and acquisition proceeds unchanged.
ROMCOM_LLM_ENABLED=false
ROMCOM_LLM_BASE=http://localhost:11434
ROMCOM_LLM_MODEL=deepseek-v4.1-flash:cloud
ROMCOM_LLM_TIMEOUT=60

# ---- Web UI master login ------------------------------------------------------------
# Leave BOTH blank to run unprotected (the default, and how the app runs today).
# Set both to require a login on every tab and API route. These are read directly from the
# environment by webauth.py and are deliberately NOT part of the settings system, so they
# can never be saved to app_settings or echoed back by GET /api/settings.
ROMCOM_WEB_USER=
ROMCOM_WEB_PASS=
# Bearer key for programmatic MCP clients on POST /mcp. MCP clients can't do a browser
# login, so this endpoint requires this key and is never open.
ROMCOM_MCP_KEY=

# ---- AI assistant -------------------------------------------------------------------
ROMCOM_CHAT_ENABLED=false
# Leave blank to auto-pick the first locally-present tool-capable model from Ollama.
ROMCOM_CHAT_MODEL=
ROMCOM_CHAT_EMBED_MODEL=nomic-embed-text:latest
ROMCOM_CHAT_HISTORY_MAX=20

# ---- MCP client (external tool servers the assistant may call) -----------------------
ROMCOM_MCP_ENABLED=false
ROMCOM_MCP_SERVERS=mcp-servers.json
